{
  "name": "proyecto-algoritmos",
  "version": "1.0.0",
  "private": true,
  "description": "Gestor de tareas y proyectos con arbol binario de busqueda (backend Python + frontend React)",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "python -m uvicorn backend.main:app --port 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test": "python -m pytest"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
